<ui:FluentWindow x:Class="LetsSchoolTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Let's School Trainer"
        Width="520" Height="700"
        MinWidth="480" MinHeight="560"
        Background="{StaticResource BgBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Let's School Trainer">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/LetsSchoolTrainer.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,0,28,16">

                <!-- FUNDS AND POINTS -->
                <TextBlock Text="FUNDS AND POINTS" Style="{StaticResource SectionLabel}" />
                <ItemsControl ItemsSource="{Binding GlobalRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:TextBox Width="110" FontFamily="{StaticResource MonoFont}" FontSize="12" TextAlignment="Right"
                                                    Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" />
                                        <ui:Button Margin="8,0,0,0" Content="Set" Appearance="Primary" Command="{Binding ApplyCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- BUILDING -->
                <TextBlock Text="BUILDING" Style="{StaticResource SectionLabel}" Margin="0,26,0,8" />
                <Border Style="{StaticResource Row}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Unlock All Furniture" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Unlock every furniture blueprint, no requirements." Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" VerticalAlignment="Center" Content="Unlock" Appearance="Primary" Command="{Binding UnlockFurnitureCommand}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Row}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Clean Invalid Ground" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Remove broken ground style IDs that cause blurry rendering in the build menu." Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" VerticalAlignment="Center" Content="Clean" Appearance="Primary" Command="{Binding CleanGroundCommand}" />
                    </Grid>
                </Border>

                <!-- KNOWLEDGE BY CATEGORY -->
                <TextBlock Text="KNOWLEDGE BY CATEGORY" Style="{StaticResource SectionLabel}" Margin="0,26,0,8" />
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <TextBlock Text="Set knowledge points" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Leave a box blank to keep that category unchanged." Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                        <UniformGrid Columns="4" Margin="0,10,0,0">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Arts" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                                <ui:TextBox FontFamily="{StaticResource MonoFont}" FontSize="12" Text="{Binding ArtsText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Science" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                                <ui:TextBox FontFamily="{StaticResource MonoFont}" FontSize="12" Text="{Binding ScienceText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Culture" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                                <ui:TextBox FontFamily="{StaticResource MonoFont}" FontSize="12" Text="{Binding CultureText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Sports" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                                <ui:TextBox FontFamily="{StaticResource MonoFont}" FontSize="12" Text="{Binding SportsText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                        <ui:Button Margin="0,12,0,0" Content="Apply" Appearance="Primary" Command="{Binding ApplyKnowledgeCommand}" />
                    </StackPanel>
                </Border>

                <!-- TEACHER -->
                <TextBlock Text="TEACHER" Style="{StaticResource SectionLabel}" Margin="0,26,0,8" />
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Single teacher" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Load the list from the game, pick a teacher, then set abilities. Leave a box blank to keep it unchanged." Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" VerticalAlignment="Top" Content="Load list" Command="{Binding LoadTeachersCommand}" />
                        </Grid>
                        <ComboBox Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Teachers}" SelectedItem="{Binding SelectedTeacher}" DisplayMemberPath="Label" />
                        <UniformGrid Columns="4" Margin="0,10,0,0">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Teaching" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                                <ui:TextBox FontFamily="{StaticResource MonoFont}" FontSize="12" Text="{Binding TeachingText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Research" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                                <ui:TextBox FontFamily="{StaticResource MonoFont}" FontSize="12" Text="{Binding ResearchText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Managing" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                                <ui:TextBox FontFamily="{StaticResource MonoFont}" FontSize="12" Text="{Binding ManagingText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Cultivating" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                                <ui:TextBox FontFamily="{StaticResource MonoFont}" FontSize="12" Text="{Binding CultivatingText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                        <ui:Button Margin="0,12,0,0" Content="Apply" Appearance="Primary" Command="{Binding ApplyTeacherCommand}" />
                    </StackPanel>
                </Border>

                <!-- STAFF -->
                <TextBlock Text="STAFF" Style="{StaticResource SectionLabel}" Margin="0,26,0,8" />
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Single staff member" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Load the list, pick a person, then set their role skill. The matching certificate is granted too." Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" VerticalAlignment="Top" Content="Load list" Command="{Binding LoadStaffCommand}" />
                        </Grid>
                        <ComboBox Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Staff}" SelectedItem="{Binding SelectedStaff}" DisplayMemberPath="Label" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Role" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding StaffRoles}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Label" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Skill value" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                                <ui:TextBox FontFamily="{StaticResource MonoFont}" FontSize="12" Text="{Binding StaffSkillText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <ui:Button Margin="0,12,0,0" Content="Apply" Appearance="Primary" Command="{Binding ApplyStaffCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3"
                Padding="28,9"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                                    <Setter Property="Fill" Value="{StaticResource DotOnBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="warn">
                                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

    </Grid>
</ui:FluentWindow>
